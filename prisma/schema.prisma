generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Orden {
  id              String    @id @default(cuid())
  orden           String    @unique
  cliente         String
  ciudad          String
  colonia         String
  direccion       String
  telefono        String
  comentario      String?   @db.Text
  estadoAnulacion String?   @map("estado_anulacion")
  motivoAnulacion String?   @map("motivo_anulacion") @db.Text
  tecnicoId       String?   @map("tecnico_id")
  tecnico         Usuario?  @relation("OrdenesAsignadas", fields: [tecnicoId], references: [id], onDelete: SetNull)
  recuperadoPorId String?   @map("recuperado_por_id")
  recuperadoPor   Usuario?  @relation("OrdenesRecuperadas", fields: [recuperadoPorId], references: [id], onDelete: SetNull)
  acuse           InfoAcuseRecibido?
  avisosWhatsapp  AvisoWhatsApp[]
  solicitudesAnulacion SolicitudAnulacion[]
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([cliente])
  @@index([ciudad])
  @@index([colonia])
  @@index([telefono])
  @@index([createdAt])
  @@index([estadoAnulacion])
  @@index([tecnicoId])
  @@index([recuperadoPorId])
  @@map("ordenes")
}

model Usuario {
  id             String   @id @default(cuid())
  email          String   @unique
  nombre         String
  passwordHash   String   @map("password_hash")
  rol            String   @default("operador")
  activo         Boolean  @default(true)
  telefono       String?
  zona           String?
  empresa        String   @default("isg")
  ordenes        Orden[]  @relation("OrdenesAsignadas")
  recuperaciones Orden[]  @relation("OrdenesRecuperadas")
  avisosWhatsapp AvisoWhatsApp[]
  solicitudesAnulacion SolicitudAnulacion[]
  informesRecepcion InformeRecepcionCarga[]
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([rol])
  @@map("usuarios")
}

model InfoAcuseRecibido {
  id             String   @id @default(cuid())
  ordenId        String   @unique @map("orden_id")
  orden          Orden    @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  cliente        String
  contrato       String
  fecha          String
  modemOnu       String   @default("") @map("modem_onu")
  router         String   @default("")
  equipoDigital  String   @default("") @map("equipo_digital")
  accesorios     Json     @default("{}")
  nombreFirma    String   @map("nombre_firma")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("info_acuse_recibido")
}

model AvisoWhatsApp {
  id           String   @id @default(cuid())
  ordenId      String?  @map("orden_id")
  orden        Orden?   @relation(fields: [ordenId], references: [id], onDelete: SetNull)
  numeroOrden  String   @map("numero_orden")
  cliente      String
  telefono     String
  empresa      String
  enviadoPorId String?  @map("enviado_por_id")
  enviadoPor   Usuario? @relation(fields: [enviadoPorId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([ordenId])
  @@index([enviadoPorId])
  @@map("avisos_whatsapp")
}

model SolicitudAnulacion {
  id              String   @id @default(cuid())
  ordenId         String?  @map("orden_id")
  orden           Orden?   @relation(fields: [ordenId], references: [id], onDelete: SetNull)
  numeroOrden     String   @map("numero_orden")
  cliente         String
  ciudad          String
  colonia         String
  telefono        String
  motivo          String   @db.Text
  solicitadoPorId String?  @map("solicitado_por_id")
  solicitadoPor   Usuario? @relation(fields: [solicitadoPorId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([ordenId])
  @@index([solicitadoPorId])
  @@map("solicitudes_anulacion")
}

model InformeRecepcionCarga {
  id          String                 @id @default(cuid())
  archivo     String
  filas       Int
  subidoPorId String?                @map("subido_por_id")
  subidoPor   Usuario?               @relation(fields: [subidoPorId], references: [id], onDelete: SetNull)
  items       InformeRecepcionFila[]
  periodo     String
  createdAt   DateTime               @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([subidoPorId])
  @@index([periodo])
  @@map("informes_recepcion_cargas")
}

model InformeRecepcionFila {
  id             String   @id @default(cuid())
  cargaId        String   @map("carga_id")
  carga          InformeRecepcionCarga @relation(fields: [cargaId], references: [id], onDelete: Cascade)
  posicion       Int
  n              String   @default("")
  fechaCliente   String   @default("") @map("fecha_cliente")
  tipoEquipo     InformeRecepcionTipoEquipo?
  datosCliente   InformeRecepcionDatosCliente?
  datosEquipo    InformeRecepcionDatosEquipo?
  datosRecepcion InformeRecepcionDatosRecepcion?
  equipoPendiente InformeRecepcionEquipoPendiente?

  @@index([cargaId])
  @@index([cargaId, posicion])
  @@map("informes_recepcion_filas")
}

model InformeRecepcionTipoEquipo {
  id             String               @id @default(cuid())
  filaId         String               @unique @map("fila_id")
  fila           InformeRecepcionFila @relation(fields: [filaId], references: [id], onDelete: Cascade)
  cajaTvAnaloga  String               @default("") @map("caja_tv_analoga")
  dtt            String               @default("")
  dth            String               @default("")
  modem          String               @default("")
  ont            String               @default("")
  router         String               @default("")
  otros          String               @default("")
  tipoEquipo     String               @default("") @map("tipo_equipo")
  identificador  String               @default("")

  @@map("informes_recepcion_tipo_equipo")
}

model InformeRecepcionDatosCliente {
  id              String               @id @default(cuid())
  filaId          String               @unique @map("fila_id")
  fila            InformeRecepcionFila @relation(fields: [filaId], references: [id], onDelete: Cascade)
  modelo          String               @default("")
  codigoCliente   String               @default("") @map("codigo_cliente")
  contratoAnulado String               @default("") @map("contrato_anulado")
  numeroOrden     String               @default("") @map("numero_orden")

  @@map("informes_recepcion_datos_cliente")
}

model InformeRecepcionDatosEquipo {
  id          String               @id @default(cuid())
  filaId      String               @unique @map("fila_id")
  fila        InformeRecepcionFila @relation(fields: [filaId], references: [id], onDelete: Cascade)
  serie       String               @default("")
  codigoBarra String               @default("") @map("codigo_barra")
  tarjeta     String               @default("")

  @@map("informes_recepcion_datos_equipo")
}

model InformeRecepcionDatosRecepcion {
  id               String               @id @default(cuid())
  filaId           String               @unique @map("fila_id")
  fila             InformeRecepcionFila @relation(fields: [filaId], references: [id], onDelete: Cascade)
  tecnico          String               @default("")
  empresaEjecutora String               @default("") @map("empresa_ejecutora")
  procedencia      String               @default("")
  ciudad           String               @default("")
  region           String               @default("")
  empresa          String               @default("")
  supervisor       String               @default("")

  @@map("informes_recepcion_datos_recepcion")
}

model InformeRecepcionEquipoPendiente {
  id              String               @id @default(cuid())
  filaId          String               @unique @map("fila_id")
  fila            InformeRecepcionFila @relation(fields: [filaId], references: [id], onDelete: Cascade)
  cajaTvAnalogaP  String               @default("") @map("caja_tv_analoga_p")
  dttP            String               @default("") @map("dtt_p")
  dthP            String               @default("") @map("dth_p")
  modemP          String               @default("") @map("modem_p")
  ontP            String               @default("") @map("ont_p")
  routerP         String               @default("") @map("router_p")
  otrosP          String               @default("") @map("otros_p")
  totalP          String               @default("") @map("total_p")

  @@map("informes_recepcion_equipo_pendiente")
}

model RateLimitBucket {
  key     String   @id @db.VarChar(180)
  count   Int      @default(0)
  resetAt DateTime @map("reset_at")

  @@index([resetAt])
  @@map("rate_limit_buckets")
}
